{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://backend-mocha-tau-49.vercel.app/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://backend-mocha-tau-49.vercel.app/health"
    }
  ],
  "redirects": [
    {
      "source": "/chiangmaieyes-dashboard(.html)?",
      "destination": "/",
      "permanent": true
    }
  ],
  "git": {
    "deploymentEnabled": false
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"
        }
      ]
    }
  ]
}

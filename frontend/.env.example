# Local frontend API target. Production sets this in Vercel.
VITE_API_BASE_URL=http://localhost:8000

# MapTiler tile key (free tier). Get one at https://www.maptiler.com/cloud/
# Publishable/client-side key — restrict by domain in the MapTiler dashboard for prod.
VITE_MAPTILER_KEY=

# Copernicus Data Space / Sentinel Hub configuration instance for WMTS NDVI tiles.
# Publishable client-side id; restrict allowed domains in the Sentinel Hub dashboard.
VITE_CDSE_SENTINEL_HUB_INSTANCE_ID=e2332d57-eb4d-47de-b3d9-1409d0ee8956

# Optional Supabase Auth/user-report integration.
# Use the publishable browser key only. Never expose service role keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback for existing Supabase projects; prefer publishable keys for new setup.
VITE_SUPABASE_ANON_KEY=

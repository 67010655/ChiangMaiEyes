# Local backend configuration. Keep real keys in backend/.env or Vercel env vars.
CORS_ORIGINS=http://localhost:5173,https://chiangmaieyes.vercel.app
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile
GISTDA_API_KEY=
GISTDA_DISASTER_API_KEY=
NASA_FIRMS_MAP_KEY=
HOTSPOT_INCLUDE_RFD=false
# Copernicus Data Space (free, operational/government-usable) Sentinel-2 dryness.
# Create an OAuth client at https://dataspace.copernicus.eu (User dashboard).
# When both are set, real NDVI/NDMI/NBR replace the seeded dryness zones.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
# Supabase (free tier) for real community field reports. Apply
# backend/migrations/0001_field_reports.sql, then set both. The service key is
# server-only — never put it in a VITE_* / browser-visible variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DEFAULT_GISTDA_DISASTER_API_KEY =